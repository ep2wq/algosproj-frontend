# Cloudflare Pages response headers (copied to dist/ as is). HTML and every other file revalidate on
# each visit; the hashed build files in /assets and the fonts are cached for a year. "! Cache-Control"
# drops the header the /* rule set, so the two values are not joined. A font that changes needs a new
# file name, or returning visitors keep the old one for a year.
/*
  Cache-Control: no-cache

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
