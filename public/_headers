# Cloudflare Pages response headers (copied to dist/ as is). HTML and every other file revalidate on
# each visit; the hashed build files in /assets and the fonts are cached for a year. "! Cache-Control"
# drops the header the /* rule set, so the two values are not joined. A font that changes needs a new
# file name, or returning visitors keep the old one for a year.
#
# Security headers on every response. scripts/prerender.mjs fills in the two placeholders of the
# Content-Security-Policy at build time: the sha256 of each inline script in index.html and the API's
# origin from VITE_API_URL. Styles allow 'unsafe-inline' (the prerendered markup has style attributes;
# the theme script and Monaco add <style> elements). Nothing loads from another host.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' %INLINE_SCRIPT_HASHES%; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' %API_ORIGIN%; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
